<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DadPlanner2.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:sys="using:System"
        xmlns:local="using:DadPlanner2"
        xmlns:models="using:DadPlanner2.Models"
        xmlns:converters="using:DadPlanner2.Converters"
        x:Class="DadPlanner2.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="Dad-Planner System Utility" Width="2134" Height="1225"
        Background="#121212" Foreground="#e0e0e0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ModeToColorConverter x:Key="ModeColorConverter"/>
        <converters:RelativeTimeConverter x:Key="RelTimeConverter"/>
        <converters:CountdownConverter x:Key="CountConverter"/>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding ToggleStealthCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Button.btn-icon">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="Button.btn-icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#555"/>
        </Style>

        <!-- Clickable Heatmap Square Style -->
        <Style Selector="Button.heatmap-cell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.heatmap-cell:pointerover">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- Global ToolTip Override for the Heatmap -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Compact Dose Selector Combobox -->
        <Style Selector="ComboBox.dose-selector">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="55"/>
        </Style>
        <Style Selector="ComboBox.dose-selector:pointerover /template/ Border#border">
            <Setter Property="BorderBrush" Value="#007acc"/>
        </Style>
    </Window.Styles>

    <!-- The root grid tracks the pointer to feed the custom overlay tooltip -->
    <Grid Background="#121212" PointerMoved="MainContainer_PointerMoved">

        <!-- MAIN APP LAYER -->
        <Grid RowDefinitions="Auto, Auto, *" Margin="20">
            <Grid.Effect>
                <BlurEffect Radius="{Binding StealthBlurRadius}" />
            </Grid.Effect>

            <!-- HEADER -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <TextBlock Text="Dad-Planner System Utility" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="btn-icon" Content="[?] Help" Command="{Binding OpenHelpCommand}" Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1"/>
                    <Button Classes="btn-icon" Content="{Binding PdfButtonText}" Command="{Binding GeneratePdfCommand}" Background="#546e7a"/>
                    <Button Classes="btn-icon" Content="[+] Add Past Log" Command="{Binding OpenManualLogCommand}"/>
                    <Button Classes="btn-icon" Content="[=] Settings" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>

            <!-- BANNERS -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,15">
                <!-- TEST MODE BANNER -->
                <Border IsVisible="{Binding IsTestModeActive}" Background="#d32f2f" CornerRadius="6" Padding="10,5">
                    <TextBlock Text="WARNING: TEST MODE ACTIVE. FAKE DATA DISPLAYED." FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>

                <!-- ENHANCED THERMAL SHADOW BANNER -->
                <Border IsVisible="{Binding IsShadowActive}" Background="#873600" BorderBrush="#ff9800" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="THERMAL SHADOW ACTIVE" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ShadowStageTitle}" FontWeight="SemiBold" Foreground="#ffe0b2" Margin="15,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ShadowProgressPercent, StringFormat='{}{0:F0}% Complete'}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar Value="{Binding ShadowProgressPercent}" Minimum="0" Maximum="100" Height="5" Foreground="#ffb74d" Background="#4e2600" CornerRadius="2.5"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding ShadowStageDesc}" FontSize="11" Foreground="#ffcc80" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ShadowMessage}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ENHANCED CLINICAL BLACKOUT BANNER -->
                <Border IsVisible="{Binding IsBlackoutActive}" Background="{Binding BlackoutColor}" BorderBrush="{Binding BlackoutBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                  <Grid ColumnDefinitions="*, Auto, Auto">
                      <!-- Main Message -->
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                          <TextBlock Text="{Binding BlackoutMessage}" FontWeight="Bold" Foreground="White"/>
                      </StackPanel>

                      <!-- The WHO Status -->
                      <Border Grid.Column="1" IsVisible="{Binding ClinicalComplianceMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="#1e1e1e" BorderBrush="{Binding ClinicalComplianceColor}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                          <TextBlock Text="{Binding ClinicalComplianceMessage}" FontSize="11" FontWeight="Bold" Foreground="{Binding ClinicalComplianceColor}" VerticalAlignment="Center"/>
                      </Border>

                      <!-- The Target Clearance Window -->
                      <Border Grid.Column="2" IsVisible="{Binding ClinicalComplianceMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="#1e1e1e" BorderBrush="{Binding ClinicalComplianceColor}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                          <TextBlock Text="{Binding ClinicalClearanceTarget}" FontSize="11" FontWeight="Bold" Foreground="{Binding ClinicalComplianceColor}" VerticalAlignment="Center"/>
                      </Border>
                  </Grid>
              </Border>
            </StackPanel>

            <!-- MAIN SPLIT -->
            <Grid Grid.Row="2" ColumnDefinitions="1.8*, 1.2*">

                <!-- LEFT PANE -->
                <ScrollViewer Grid.Column="0" Margin="0,0,15,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="15">

                        <!-- ENHANCED HUD GRID WITH BIOLOGICAL PHASES -->
                        <UniformGrid Columns="5" Height="80">
                            <!-- 1: Current Delta -->
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" Padding="8">
                                <Grid RowDefinitions="*, Auto">
                                    <TextBlock Grid.Row="0" Text="{Binding HudCurrent}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="CURRENT DELTA" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2: Phase & Viability / Limit (Dynamic Color + Progress Bar) -->
                            <Border Background="#1e1e1e" BorderBrush="{Binding HudPhaseColor}" BorderThickness="1.5" CornerRadius="6" Margin="0,0,10,0" Padding="8">
                                <Grid RowDefinitions="*, Auto, Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding HudRemaining}" FontSize="22" FontWeight="Bold" Foreground="{Binding HudPhaseColor}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Value="{Binding HudProgressValue}" Minimum="0" Maximum="1" Height="3" Foreground="{Binding HudPhaseColor}" Background="#2a2a2a" CornerRadius="1.5" Margin="4,2,4,4"/>
                                    <TextBlock Grid.Row="2" Text="{Binding HudRemainingLabel}" FontSize="9" FontWeight="Bold" Foreground="{Binding HudPhaseColor}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 3: Rolling Average -->
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" Padding="8">
                                <Grid RowDefinitions="*, Auto">
                                    <TextBlock Grid.Row="0" Text="{Binding HudAvg}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="ROLLING AVG" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 4: Max Endurance -->
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" Padding="8">
                                <Grid RowDefinitions="*, Auto">
                                    <TextBlock Grid.Row="0" Text="{Binding HudMax}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="MAX ENDURANCE" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 5: 30-Day Frequency -->
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid RowDefinitions="*, Auto">
                                    <TextBlock Grid.Row="0" Text="{Binding HudFrequency}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="30-DAY FREQ" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- RECOVERY GAP TIMELINE WITH ZOOM -->
                        <Border Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Height="250">
                            <Grid RowDefinitions="Auto, *">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="RECOVERY GAP TIMELINE" FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="10,10,0,5"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5" Margin="0,10,10,5">
                                        <TextBlock Text="GLOBAL SCALE:" FontSize="10" FontWeight="Bold" Foreground="#007acc" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button Content="14D" Command="{Binding ZoomChartCommand}" CommandParameter="14" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                        <Button Content="30D" Command="{Binding ZoomChartCommand}" CommandParameter="30" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                        <Button Content="90D" Command="{Binding ZoomChartCommand}" CommandParameter="90" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                        <Button Content="180D" Command="{Binding ZoomChartCommand}" CommandParameter="180" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                        <Button Content="ALL" Command="{Binding ZoomChartCommand}" CommandParameter="ALL" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                    </StackPanel>
                                </Grid>

                                <lvc:CartesianChart x:Name="MainChart" Grid.Row="1" Series="{Binding ChartSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Sections="{Binding TimelineSections}" Margin="10,0,10,10" ZoomMode="X" DataPointerDownCommand="{Binding ChartClickedCommand}" TooltipPosition="Hidden" />
                            </Grid>
                        </Border>

                        <!-- Analytics Charts -->
                        <Grid ColumnDefinitions="*, *" Height="200">

                            <!-- Doughnut Chart & Custom Legend -->
                            <Border Grid.Column="0" Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <Grid RowDefinitions="Auto, *">
                                    <TextBlock Grid.Row="0" Text="EVENT DISTRIBUTION" FontSize="12" Foreground="#888" Margin="10,10,0,5"/>

                                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="10,0,15,10">
                                        <Grid Grid.Column="0">
                                            <lvc:PieChart x:Name="PieChart" Series="{Binding ModeSeries}" LegendPosition="Hidden" TooltipPosition="Hidden"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TotalEventCount}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Total Logs" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#007acc"/>
                                                <TextBlock Text="{Binding LegendMaint}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#9c27b0"/>
                                                <TextBlock Text="{Binding LegendPlay}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#4caf50"/>
                                                <TextBlock Text="{Binding LegendBaby}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#546e7a"/>
                                                <TextBlock Text="{Binding LegendLab}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Bar Chart (Yield Profile) -->
                            <Border Grid.Column="1" Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto, *">
                                    <TextBlock Grid.Row="0" Text="YIELD PROFILE" FontSize="12" Foreground="#888" Margin="10,10,0,5"/>
                                    <lvc:CartesianChart x:Name="BarChart" Grid.Row="1" Series="{Binding VolumeSeries}" XAxes="{Binding VolumeXAxes}" YAxes="{Binding VolumeYAxes}" Margin="10" TooltipPosition="Hidden"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- GitHub-Style Auto-Scaling Heatmap with Interactive Drill-Down -->
                        <Border Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="365-DAY ACTIVITY MATRIX (CLICK DAY TO LOCATE)" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" OffContent="Release Frequency" OnContent="Clinical Volume" IsChecked="{Binding IsVolumeMode}" FontSize="11" Foreground="#aaa" MinWidth="0" Margin="0" Padding="0"/>
                                </Grid>

                                <Viewbox Height="110" Stretch="Uniform" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding HeatmapDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Vertical" Height="110" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="heatmap-cell"
                                                        Background="{Binding ColorHex}"
                                                        Width="12" Height="12" Margin="1.5" CornerRadius="2"
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).HeatmapDayClickedCommand}"
                                                        CommandParameter="{Binding}">
                                                    <ToolTip.Tip>
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="{Binding DateText}" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                                                            <TextBlock Text="{Binding MainInfoText}" Foreground="#aaa" FontSize="12"/>
                                                            <Rectangle IsVisible="{Binding HasData}" Height="1" Fill="#333" Margin="0,4"/>
                                                            <TextBlock IsVisible="{Binding HasData}" Text="{Binding ModesText}" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
                                                            <TextBlock Text="Click cell to jump to log" FontSize="9" Foreground="#007acc" FontStyle="Italic"/>
                                                        </StackPanel>
                                                    </ToolTip.Tip>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>
                                
                                <!-- Explicit Heatmap Legend -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,5,10,0">
                                    <TextBlock Text="Base Color = Mode" FontSize="9" FontWeight="Bold" Foreground="#777" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Intensity:" FontSize="9" Foreground="#666" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBlock Text="Low" FontSize="9" Foreground="#666" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#252526" BorderBrush="#333" BorderThickness="1"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#1e4a6d"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#007acc"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#64b5f6"/>
                                    <TextBlock Text="High" FontSize="9" Foreground="#666" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>

                                <!-- ENTHUSIASM MACRO-TREND GRAPH -->
                                <Grid Height="140" Margin="0,15,0,0"> 
                                    <lvc:CartesianChart x:Name="EnthusiasmChart" Series="{Binding EnthusiasmSeries}" XAxes="{Binding EnthusiasmXAxes}" YAxes="{Binding EnthusiasmYAxes}" TooltipPosition="Hidden" ZoomMode="X" />
                                    
                                    <!-- Ghost Line & Actual Line Legends -->
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" IsHitTestVisible="False" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="12" Height="3" Background="#f57c00" VerticalAlignment="Center"/>
                                            <TextBlock Text="ACTUAL 14-DAY EXPENDITURE" FontSize="9" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="- - -" FontWeight="Bold" Foreground="#777" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding EnthusiasmTargetScore, StringFormat='TARGET EXPENDITURE: {0:F1}'}" FontSize="9" FontWeight="Bold" Foreground="#777" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- PHARMACOKINETIC DECAY OVERLAY -->
                                <Grid Height="140" Margin="0,15,0,0"> 
                                    <lvc:CartesianChart x:Name="PkChart" Series="{Binding PkSeries}" XAxes="{Binding PkXAxes}" YAxes="{Binding PkYAxes}" TooltipPosition="Hidden" ZoomMode="X" />
                                    
                                    <!-- PK Legend -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" IsHitTestVisible="False" Spacing="15">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z" Width="10" Height="10" Foreground="#007acc" VerticalAlignment="Center"/>
                                            <TextBlock Text="Zn (12d)" FontSize="9" Foreground="#007acc" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11 2,11C2,11 4,8 9,7C14,6 17,8 17,8Z" Width="10" Height="10" Foreground="#9c27b0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ma (20h)" FontSize="9" Foreground="#9c27b0" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="M12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9M12,4.5C13.13,4.5 13.5,4.87 13.5,6V7.5C13.5,8.63 13.13,9 12,9C10.87,9 10.5,8.63 10.5,7.5V6C10.5,4.87 10.87,4.5 12,4.5M12,15C10.87,15 10.5,15.37 10.5,16.5V18C10.5,19.13 10.87,19.5 12,19.5C13.13,19.5 13.5,19.13 13.5,18V16.5C13.5,15.37 13.13,15 12,15M4.5,12C4.5,10.87 4.87,10.5 6,10.5H7.5C8.63,10.5 9,10.87 9,12C9,13.13 8.63,13.5 7.5,13.5H6C4.87,13.5 4.5,13.13 4.5,12M15,12C15,13.13 15.37,13.5 16.5,13.5H18C19.13,13.5 19.5,13.13 19.5,12C19.5,10.87 19.13,10.5 18,10.5H16.5C15.37,10.5 15,10.87 15,12Z" Width="10" Height="10" Foreground="#4caf50" VerticalAlignment="Center"/>
                                            <TextBlock Text="D3 (18d)" FontSize="9" Foreground="#4caf50" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Width="10" Height="10" Foreground="#f57c00" VerticalAlignment="Center"/>
                                            <TextBlock Text="C (24h)" FontSize="9" Foreground="#f57c00" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="M11,2H13V19H11V2M9,20H15V22H9V20M12,0L15,3H9L12,0Z" Width="10" Height="10" Foreground="#e53935" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tad (17.5h)" FontSize="9" Foreground="#e53935" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT PANE -->
                <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *" Background="#1a1a1a" Margin="5,0,0,0">
                    
                    <!-- NEW EVENT FORM -->
                    <Border Grid.Row="0" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="LOG NEW EVENT" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                                <!-- Silent Diurnal Hint -->
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding DiurnalPeakText}" 
                                           IsVisible="{Binding DiurnalPeakText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="10" 
                                           Foreground="#4caf50" 
                                           FontWeight="SemiBold" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid ColumnDefinitions="*, *">
                                <ComboBox Grid.Column="0" SelectedIndex="{Binding SelectedHeat}" HorizontalAlignment="Stretch" Margin="0,0,5,0">
                                    <ComboBoxItem>Temp: Normal</ComboBoxItem>
                                    <ComboBoxItem>Temp: L1 (Mild)</ComboBoxItem>
                                    <ComboBoxItem>Temp: L2 (Fever)</ComboBoxItem>
                                    <ComboBoxItem>Temp: L3 (Severe)</ComboBoxItem>
                                </ComboBox>
                                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedVolume}" HorizontalAlignment="Stretch" Margin="5,0,0,0">
                                    <x:String>Normal</x:String>
                                    <x:String>Low</x:String>
                                    <x:String>High</x:String>
                                    <x:String>None</x:String>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*, *">
                                <TextBox Grid.Column="0" Text="{Binding SelectedReleaseCount}" Watermark="Release count" Margin="2"/>
                                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedVolumeConfidence}" Margin="2">
                                    <x:Static Member="models:VolumeConfidence.Observed"/>
                                    <x:Static Member="models:VolumeConfidence.Estimated"/>
                                    <x:Static Member="models:VolumeConfidence.Unknown"/>
                                </ComboBox>
                            </Grid>
                            <Border Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="SUPPS:" FontSize="11" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                                        <CheckBox IsChecked="{Binding ZincActive}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z" Width="11" Height="11" Foreground="#007acc" VerticalAlignment="Center"/>
                                                <TextBlock Text="Zn" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding MacaActive}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11 2,11C2,11 4,8 9,7C14,6 17,8 17,8Z" Width="11" Height="11" Foreground="#4caf50" VerticalAlignment="Center"/>
                                                <TextBlock Text="Ma" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding VitDActive}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9M12,4.5C13.13,4.5 13.5,4.87 13.5,6V7.5C13.5,8.63 13.13,9 12,9C10.87,9 10.5,8.63 10.5,7.5V6C10.5,4.87 10.87,4.5 12,4.5M12,15C10.87,15 10.5,15.37 10.5,16.5V18C10.5,19.13 10.87,19.5 12,19.5C13.13,19.5 13.5,19.13 13.5,18V16.5C13.5,15.37 13.13,15 12,15M4.5,12C4.5,10.87 4.87,10.5 6,10.5H7.5C8.63,10.5 9,10.87 9,12C9,13.13 8.63,13.5 7.5,13.5H6C4.87,13.5 4.5,13.13 4.5,12M15,12C15,13.13 15.37,13.5 16.5,13.5H18C19.13,13.5 19.5,13.13 19.5,12C19.5,10.87 19.13,10.5 18,10.5H16.5C15.37,10.5 15,10.87 15,12Z" Width="11" Height="11" Foreground="#ffb74d" VerticalAlignment="Center"/>
                                                <TextBlock Text="D3" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding VitCActive}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Width="11" Height="11" Foreground="#f57c00" VerticalAlignment="Center"/>
                                                <TextBlock Text="C" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding TadalafilActive}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="M11,2H13V19H11V2M9,20H15V22H9V20M12,0L15,3H9L12,0Z" Width="11" Height="11" Foreground="#e53935" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Tad" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <ComboBox Classes="dose-selector" SelectedItem="{Binding TadalafilDose}" IsEnabled="{Binding TadalafilActive}" Margin="0,0,4,0">
                                                <sys:Int32>5</sys:Int32>
                                                <sys:Int32>10</sys:Int32>
                                                <sys:Int32>20</sys:Int32>
                                            </ComboBox>
                                            <TextBlock Text="mg" FontSize="9" Foreground="#888" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Quick Log Button -->
                                    <Button Content="Quick-Log Daily Supplements (No Timeline Reset)" 
                                            Command="{Binding LogDailySupplementsCommand}" 
                                            Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" 
                                            Foreground="#aaa" FontSize="10" 
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="CLINICAL METRICS (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>
                                    <UniformGrid Columns="3">
                                        <TextBox Text="{Binding ClinicalVol}" Watermark="Vol (mL)" Margin="2"/>
                                        <TextBox Text="{Binding Concentration}" Watermark="Conc (M)" Margin="2"/>
                                        <TextBox Text="{Binding Motility}" Watermark="Tot Mot (%)" Margin="2"/>
                                        <TextBox Text="{Binding ProgMotility}" Watermark="Prog Mot (%)" Margin="2"/>
                                        <TextBox Text="{Binding Morphology}" Watermark="Morph (%)" Margin="2"/>
                                        <TextBox Text="{Binding PhLevel}" Watermark="pH Level" Margin="2"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Notes Field -->
                            <TextBox Text="{Binding SelectedNotes}" Watermark="Context, symptoms, external factors..." TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,5,0,5" />

                            <UniformGrid Columns="2" Rows="2">
                                <Button Content="Maintenance" Command="{Binding LogEventCommand}" CommandParameter="Maintenance" Background="#007acc" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                                <Button Content="Playtime" Command="{Binding LogEventCommand}" CommandParameter="Playtime" Background="#9c27b0" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                                <Button Content="Baby-Making" Command="{Binding LogEventCommand}" CommandParameter="Baby-Making" Background="#2e7d32" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                                <Button Content="Clinical Lab" Command="{Binding LogEventCommand}" CommandParameter="Clinical-Lab" Background="#546e7a" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- NEW FILTER BAR -->
                    <Border Grid.Row="1" Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <Grid ColumnDefinitions="Auto, *, *, *">
                            <TextBlock Grid.Column="0" Text="FILTER:" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                            
                            <ComboBox Grid.Column="1" SelectedItem="{Binding FilterMode}" HorizontalAlignment="Stretch" Margin="0,0,5,0">
                                <x:String>All</x:String>
                                <x:String>Maintenance</x:String>
                                <x:String>Playtime</x:String>
                                <x:String>Baby-Making</x:String>
                                <x:String>Clinical-Lab</x:String>
                                <x:String>Daily Dose</x:String>
                            </ComboBox>
                            
                            <ComboBox Grid.Column="2" SelectedItem="{Binding FilterVolume}" HorizontalAlignment="Stretch" Margin="5,0,5,0">
                                <x:String>All</x:String>
                                <x:String>High</x:String>
                                <x:String>Normal</x:String>
                                <x:String>Low</x:String>
                                <x:String>None</x:String>
                            </ComboBox>
                            
                            <ComboBox Grid.Column="3" SelectedItem="{Binding FilterSupplement}" HorizontalAlignment="Stretch" Margin="5,0,0,0">
                                <x:String>All</x:String>
                                <x:String>Zinc</x:String>
                                <x:String>Maca</x:String>
                                <x:String>Vit D3</x:String>
                                <x:String>Vit C</x:String>
                                <x:String>Tadalafil</x:String>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="LogsGrid" Grid.Row="2" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}" IsReadOnly="True" AutoGenerateColumns="False" Background="#1e1e1e" Margin="0,15,0,0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, Converter={StaticResource RelTimeConverter}}" />
                            <DataGridTemplateColumn Header="Mode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode}" Foreground="{Binding Mode, Converter={StaticResource ModeColorConverter}}" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Metrics" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MetricsDisplay}" VerticalAlignment="Center" FontSize="11" Foreground="#aaa" Margin="5,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MetricsDisplay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button IsVisible="{Binding HasPdf}" Content="PDF" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenPdfCommand}" CommandParameter="{Binding Id}" Background="#546e7a" Foreground="White" FontSize="10" Padding="6,4" Margin="2"/>
                                            <Button Content="EDIT" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenEditLogCommand}" CommandParameter="{Binding Id}" Background="#f57c00" Foreground="White" FontSize="10" Padding="6,4" Margin="2"/>
                                            <Button Content="PURGE" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DeleteLogCommand}" CommandParameter="{Binding Id}" Background="#d32f2f" Foreground="White" FontSize="10" Padding="6,4" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- UI OVERLAY LAYER -->
        <Canvas IsHitTestVisible="False" ZIndex="999">
            <Border IsVisible="{Binding IsTooltipVisible}" Canvas.Left="{Binding TooltipX}" Canvas.Top="{Binding TooltipY}" Background="#1e1e1e" BorderBrush="#555" BorderThickness="1" CornerRadius="6" Padding="15" BoxShadow="0 8 16 0 #B2000000">
                <StackPanel>

                    <StackPanel IsVisible="{Binding HoveredTimelinePoint, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="{Binding HoveredTimelinePoint.HeaderText}" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <TextBlock Text="{Binding HoveredTimelinePoint.GapText}" Foreground="#aaa" FontSize="12"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Mode:" Foreground="#888" FontSize="12"/>
                            <TextBlock Text="{Binding HoveredTimelinePoint.Log.Mode}" Foreground="{Binding HoveredTimelinePoint.ModeHex}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Yield:" Foreground="#888" FontSize="12"/>
                            <TextBlock Text="{Binding HoveredTimelinePoint.Log.Volume}" Foreground="#ccc" FontSize="12"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding HoveredTimelinePoint.HasFlags, FallbackValue=False}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding HoveredTimelinePoint.FlagsText}" Foreground="#ff9800" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <Border IsVisible="{Binding HoveredTimelinePoint.HasLab, FallbackValue=False}" Margin="0,4,0,0" Background="#263238" Padding="6" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="CLINICAL DATA:" Foreground="#90a4ae" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding HoveredTimelinePoint.LabText}" Foreground="#fff" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HoveredPie, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="CATEGORY DISTRIBUTION" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <TextBlock Text="{Binding HoveredPie.Category}" Foreground="{Binding HoveredPie.ColorHex}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding HoveredPie.Count, StringFormat='Total Events: {0}'}" Foreground="#aaa" FontSize="12"/>
                        <TextBlock Text="{Binding HoveredPie.Percentage, StringFormat='Share: {0}%'}" Foreground="#888" FontSize="12"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HoveredBar, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="YIELD VOLUME" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <TextBlock Text="{Binding HoveredBar.Category}" Foreground="{Binding HoveredBar.ColorHex}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding HoveredBar.Count, StringFormat='Total Sessions: {0}'}" Foreground="#aaa" FontSize="12"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HoveredEnthusiasm, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="MACRO-TREND EXPENDITURE" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <TextBlock Text="{Binding HoveredEnthusiasm.DateText}" Foreground="#aaa" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="14-Day Actual:" Foreground="#888" FontSize="12" Width="85"/>
                            <TextBlock Text="{Binding HoveredEnthusiasm.Score, StringFormat='{}{0:F1}'}" Foreground="#f57c00" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="14-Day Target:" Foreground="#666" FontSize="12" Width="85"/>
                            <TextBlock Text="{Binding EnthusiasmTargetScore, StringFormat='{}{0:F1}'}" Foreground="#888" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HoveredPk, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="PHARMACOKINETIC SATURATION" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <TextBlock Text="{Binding HoveredPk.DateText}" Foreground="#aaa" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Zinc (12d):" Foreground="#007acc" FontSize="12" Width="90"/>
                            <TextBlock Text="{Binding HoveredPk.Zinc, StringFormat='{}{0:F2}'}" Foreground="#fff" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Maca (20h):" Foreground="#9c27b0" FontSize="12" Width="90"/>
                            <TextBlock Text="{Binding HoveredPk.Maca, StringFormat='{}{0:F2}'}" Foreground="#fff" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Vit D3 (18d):" Foreground="#4caf50" FontSize="12" Width="90"/>
                            <TextBlock Text="{Binding HoveredPk.VitD, StringFormat='{}{0:F2}'}" Foreground="#fff" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Vit C (24h):" Foreground="#f57c00" FontSize="12" Width="90"/>
                            <TextBlock Text="{Binding HoveredPk.VitC, StringFormat='{}{0:F2}'}" Foreground="#fff" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Tadalafil (17.5h):" Foreground="#e53935" FontSize="12" Width="90"/>
                            <TextBlock Text="{Binding HoveredPk.Tadalafil, StringFormat='{}{0:F2}'}" Foreground="#fff" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Canvas>

        <!-- HELP MODAL -->
        <Border IsVisible="{Binding IsHelpOpen}" Background="#B2000000" ZIndex="500">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="780" MaxHeight="750" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Dad-Planner 2: Operator's Manual &amp; Field Guide" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseHelpCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="15" Margin="0,0,15,0">

                            <!-- Section 1: Quick Start -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5">
                                <TextBlock Text="1. Quick Start &amp; Overview" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="Dad-Planner 2 (DP2) keeps tabs on recovery windows, release events, reproductive habits, and clinical semen analysis records—all entirely offline and air-gapped. Log events on the fly using the right-hand panel, or click 'Add Past Log' in the header to drop in historical sessions." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Navigation: The top header gives you quick access to this manual, your 90-day PDF medical summary, manual logging, and system settings." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Data Grid: Your event log, sorted descending. Shows timestamps, mode badges, volume tiers, active supplements, and quick action buttons (PDF, EDIT, PURGE)." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>

                            <!-- Section 2: Logging a Session -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="2. Logging Controls &amp; Parameters" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="The right-hand panel handles all the nitty-gritty biological and pharmaceutical factors for each session:" TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Scrotal Temp Flag: Tracks thermal stress. Normal is standard body temp; L1 is mild warmth; L2 is a fever or a hot soak/sauna session; L3 is severe thermal shock." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Volume: Categorical yield estimate (Normal, Low, High, None/Dry)." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Release Count: How many releases happened during the session. Multi-release sessions count as a single recovery event for gap spacing, but log the full count for your frequency totals." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Volume Confidence: How sure you are about the volume. Observed means direct visual check; Estimated means the app calculated it based on your history; Unknown is unverified." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Supps Checkboxes: Active supplements during the lookback period (Zn = Zinc, Ma = Maca Root, D3 = Vitamin D3, C = Vitamin C, Tad = Tadalafil). Your settings stick around automatically." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Clinical Metrics: Optional lab inputs (volume in mL, concentration in M/mL, total motility %, progressive motility %, normal morphology %, and pH) for formal diagnostic tracking." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>

                            <!-- Section 3: Event Modes -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="3. Event Modes &amp; Automated Logic" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="• Maintenance (Blue): Standard periodic clearance to keep things running smoothly." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Playtime (Purple): Partnered recreational sessions. Defaults to observed volume." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Baby-Making (Green): Targeted conception attempts. Automatically calculates an estimated volume using your recovery gap telemetry and Zinc saturation levels unless overridden." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Clinical-Lab (Slate): Diagnostic semen sample. Prompts for formal lab numbers and lets you attach the official PDF report." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Daily Dose (Blue-Grey): A quick-log tool purely for tracking supplement intake and pharmacokinetic decay without resetting your recovery gap timer." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>

                            <!-- Section 4: Biological Recovery Phases -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="4. Biological Recovery Phases (HUD Telemetry)" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="DP2 models recovery using a 4-phase biological state machine rather than a dumb countdown clock:" TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• RECHARGING (0h to Min Rest): The rebound window. Volume and concentration are actively rebuilding. The progress bar shows how close you are to your baseline floor. Shown in Blue." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• OPTIMAL VIABILITY (Peak Window, e.g. 24h–72h): The biological sweet spot. Concentration and progressive motility hit their peak with minimal DNA Fragmentation Index (DFI). Shown in Vibrant Green." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• EXTENDED RESERVE (Ceiling to 120h): Volume and count are high, but sitting in storage too long starts ramping up oxidative stress. Shown in Amber." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• VIABILITY FADING (&gt;120h): Accelerated senescence. A sigmoid decay curve models rapid DFI escalation down to a 55% dynamic floor. Past 144 hours, aggressive turnover alerts kick in. Shown in Red." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>

                            <!-- Section 5: Thermal Shadow & Stages -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="5. The 74-Day Thermal Shadow &amp; Spermatogenesis Stages" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="Spermatogenesis takes roughly 74 days from start to finish. Scrotal heat exposure (Level 2 fever or Level 3 severe heat) triggers a 74-day recovery tracker broken down into three developmental phases:" TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Stage 1 (Days 1–14): Epididymal Transit. Heat hits already-stored cells. Motility and vitality drop immediately." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Stage 2 (Days 15–45): Spermiogenesis Transition. Affects maturing spermatids undergoing nuclear compaction. Morphology variations peak here." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Stage 3 (Days 46–74): Meiotic Regeneration. Early spermatocytes regenerate, and counts bounce back toward baseline as fresh cohorts mature." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Clinical Override: Logging a formal Clinical Lab record with concentration &gt;= 15 M/mL and progressive motility &gt;= 40% after a heat event acts as an empirical ground-truth override, instantly clearing the shadow." TextWrapping="Wrap" Foreground="#ffe0b2" Margin="10,0,0,0"/>

                            <!-- Section 6: WHO Abstinence Standards -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="6. WHO 2021 Clinical Abstinence Compliance" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="The World Health Organization (WHO 6th Edition, 2021) sets strict abstinence rules prior to diagnostic testing:" TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• WHO Gold Standard: 48 to 72 hours (2 to 3 days). The ideal clinical balance of volume, concentration, and motility." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• WHO Acceptable: 48 to 168 hours (2 to 7 days)." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Sub-48h (&lt;48h): Results in falsely depressed concentration and volume." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Extended (&gt;7d): Yields higher counts but tanks motility and spikes fragmentation." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="Locking in your upcoming appointment date in Settings turns on a compliance tracker in the Blackout banner so you know if your pacing will land you right in the 48–72h sweet spot." TextWrapping="Wrap" Foreground="#ccc"/>

                            <!-- Section 7: Pharmacokinetics -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="7. Pharmacokinetics &amp; Supplement Kinetics" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="The app models rolling saturation and elimination curves (C = C₀ · e⁻ᵏᵗ) for your stack:" TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Zinc (t½ ≈ 12 Days): Crucial for chromatin packaging and seminal volume." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Maca Root (t½ ≈ 20 Hours): Fast clearance requiring daily consistency." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Vitamin D3 (t½ ≈ 18 Days): Strongly tied to progressive motility." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Vitamin C (t½ ≈ 24 Hours): Your primary water-soluble antioxidant shield." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>
                            <TextBlock Text="• Tadalafil (t½ ≈ 17.5 Hours): PDE5 inhibitor supporting microcirculation." TextWrapping="Wrap" Foreground="#ccc" Margin="10,0,0,0"/>

                            <!-- Section 8: Interactive Charts -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="8. Charts, Analytics &amp; Activity Matrix" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="• Recovery Gap Timeline: Plots hours between consecutive releases over time. Color-coded dots reflect mode. Click any point to select and jump to that log in the table." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Event Distribution: Donut chart showing session breakdown by mode." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Yield Profile: Bar chart showing distribution of volume tiers." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• 365-Day Activity Matrix: GitHub-style annual heatmap. Toggle between Release Frequency and Clinical Volume. Darker tiles mean heavier activity." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Interactive Drill-Down: Click any day's square in the heatmap to instantly select and scroll to that session in the log table." TextWrapping="Wrap" Foreground="#90caf9"/>
                            <TextBlock Text="• 14-Day Enthusiasm: Rolling 14-day cumulative release expenditure compared against your optimal baseline." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Analyze Supps: Compares saturated versus unsaturated release windows for each supplement (saturated = present in at least 50% of recent logs)." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Auto-Calibrate: Automatically computes recommended Min Rest and Max Limit values from your uncompromised historical logs." TextWrapping="Wrap" Foreground="#ccc"/>

                            <!-- Section 9: Editing & History -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="9. Editing &amp; Audit History" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="• Edit Log: Click EDIT on any table row to fix timestamps, volume, counts, confidence, or lab metrics. Every change creates an immutable snapshot in the local audit history." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Restore: Past versions of an edited record can be reviewed and rolled back right from the edit dialog." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Purge: Permanently deletes a log entry and its associated history snapshots." TextWrapping="Wrap" Foreground="#ccc"/>

                            <!-- Section 10: Reports & Safety -->
                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="10. Reports, Database Safety &amp; Privacy" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="• 90-Day Report: Compiles a clean, printable PDF report (Baseline_Summary.pdf) complete with timelines, charts, logs, and supplement correlation stats." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Data Export: Dumps all logs, history, and analytics to portable JSON and CSV files." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• SQLite WAL Mode &amp; Safety: Uses Write-Ahead Logging with busy timeouts and automatic safety snapshots before migrations so your data never gets locked or corrupted." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Auto-Backup: Backups are automatically written on exit (keeping the last 10). You can also trigger manual backups or restores in Settings." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Stealth Mode: Hit ESC at any time to blur the entire window for instant privacy." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="• Sandbox Mode: Toggle this in Settings whenever you want to test the app against 300 simulated historical records and thermal events." TextWrapping="Wrap" Foreground="#ccc"/>

                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Border>

        <!-- GENERIC ALERT MODAL -->
        <Border IsVisible="{Binding IsAlertOpen}" Background="#B2000000" ZIndex="200">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="520" MaxHeight="680" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <TextBlock Text="{Binding AlertTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding AlertMessage}" TextWrapping="Wrap" Foreground="#ccc"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAlertCommand}" Background="#333" Foreground="White"/>
                        <Button IsVisible="{Binding ShowAlertConfirm}" Content="Confirm" Command="{Binding ConfirmAlertCommand}" Background="#007acc" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- SUPPLEMENT ANALYSIS VIEW -->
        <Border IsVisible="{Binding IsAnalysisOpen}" Background="#B2000000" ZIndex="210">
            <Border Background="#1e1e1e" BorderBrush="#4caf50" BorderThickness="1" CornerRadius="8"
                    Width="1100" MaxHeight="780" Padding="28" VerticalAlignment="Center"
                    HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Supplement Analysis" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Personal observational comparisons - not clinical evidence"
                                       FontSize="12" Foreground="#9e9e9e"/>
                        </StackPanel>
                        <Button Content="[X]" Command="{Binding CloseAnalysisCommand}" Background="Transparent"
                                Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,0" Background="#151515" BorderBrush="#333" BorderThickness="1"
                            CornerRadius="4" Padding="18">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <UniformGrid Columns="2" Rows="2">
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding ZincAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="8,0,0,8">
                                        <TextBlock Text="{Binding MacaAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="0,8,8,0">
                                        <TextBlock Text="{Binding VitaminDAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="8,8,0,0">
                                        <TextBlock Text="{Binding VitaminCAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                </UniformGrid>
                                <Border Background="#151515" Padding="12">
                                    <TextBlock Text="{Binding AnalysisMessage}" TextWrapping="Wrap"
                                               FontFamily="monospace" FontSize="13" Foreground="#d6d6d6"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="10">
                        <TextBlock Text="Full audit details are also available in exported JSON, CSV, and PDF reports."
                                   VerticalAlignment="Center" FontSize="11" Foreground="#888"/>
                        <Button Content="Close" Command="{Binding CloseAnalysisCommand}"
                                Background="#555" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- CLINICAL DELTA MATRIX MODAL -->
        <Border IsVisible="{Binding IsDeltaOpen}" Background="#B2000000" ZIndex="210">
            <Border Background="#1e1e1e" BorderBrush="#007acc" BorderThickness="1" CornerRadius="8" Width="1000" MaxHeight="780" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Clinical Delta Matrix" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Comparative lab analysis &amp; behavioral trajectory" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                        <Button Content="[X]" Command="{Binding CloseDeltaCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Selection Dropdowns -->
                    <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Baseline Lab (A)" FontSize="11" Foreground="#888"/>
                            <ComboBox ItemsSource="{Binding ClinicalLogs}" SelectedItem="{Binding SelectedLabA}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Timestamp, Converter={StaticResource RelTimeConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Comparison Lab (B)" FontSize="11" Foreground="#888"/>
                            <ComboBox ItemsSource="{Binding ClinicalLogs}" SelectedItem="{Binding SelectedLabB}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Timestamp, Converter={StaticResource RelTimeConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="1.2*, 1*" Margin="0,10,0,0" IsVisible="{Binding DeltaResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                        
                        <!-- Left Column: The Raw Numbers -->
                        <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="1" Text="LAB A" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="LAB B" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="DELTA" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#333"/>
                                <TextBlock Text="CLINICAL METRICS" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>

                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Volume (mL)" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.LabA.ClinicalVol, StringFormat='{}{0:F1}'}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.LabB.ClinicalVol, StringFormat='{}{0:F1}'}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeltaResult.VolDelta, StringFormat='{}{0:+0.0;-0.0;0.0}'}" Foreground="#007acc" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Concentration (M/mL)" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.LabA.Concentration}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.LabB.Concentration}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeltaResult.ConcDelta, StringFormat='{}{0:+0;-0;0}'}" Foreground="#007acc" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Total Motility (%)" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.LabA.Motility}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.LabB.Motility}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeltaResult.MotilityDelta, StringFormat='{}{0:+0;-0;0}'}" Foreground="#007acc" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Prog Motility (%)" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.LabA.ProgMotility}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.LabB.ProgMotility}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeltaResult.ProgMotilityDelta, StringFormat='{}{0:+0;-0;0}'}" Foreground="#007acc" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Morphology (%)" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.LabA.Morphology}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.LabB.Morphology}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeltaResult.MorphDelta, StringFormat='{}{0:+0;-0;0}'}" Foreground="#007acc" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#333" Margin="0,5"/>
                                <TextBlock Text="74-DAY BEHAVIORAL LOOKBACK" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>

                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Avg Gap (h)" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.AvgGapA, StringFormat='{}{0:F1}'}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.AvgGapB, StringFormat='{}{0:F1}'}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeltaResult.GapDelta, StringFormat='{}{0:+0.0;-0.0;0.0}'}" Foreground="#f57c00" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Thermal Shadows" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.ThermalEventsA}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.ThermalEventsB}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="--" Foreground="#555" HorizontalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="2*, *, *, *">
                                    <TextBlock Grid.Column="0" Text="Zinc Saturation (%)" Foreground="#ccc"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaResult.ZincSatA, StringFormat='{}{0:P0}'}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaResult.ZincSatB, StringFormat='{}{0:P0}'}" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="--" Foreground="#555" HorizontalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: The Relative Trajectory Chart -->
                        <Border Grid.Column="1" Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="15">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="RELATIVE IMPROVEMENT (%)" FontSize="10" FontWeight="Bold" Foreground="#90a4ae" Margin="0,0,0,10"/>
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding DeltaChartSeries}" XAxes="{Binding DeltaXAxes}" YAxes="{Binding DeltaYAxes}" TooltipPosition="Top" MinHeight="250"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock IsVisible="{Binding DeltaResult, Converter={x:Static ObjectConverters.IsNull}}" 
                               Text="Select two distinct clinical labs to view delta matrix." 
                               Foreground="#888" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- SETTINGS MODAL -->
        <Border IsVisible="{Binding IsSettingsOpen}" Background="#B2000000" ZIndex="100">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="550" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="20">
                    <Grid>
                        <TextBlock Text="Configuration &amp; Analytics" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseSettingsCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Threshold Limits" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*,*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Min Rest (Hrs)" FontSize="11" Foreground="#888"/>
                                <TextBox Text="{Binding MinHours}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Max Limit (Hrs)" FontSize="11" Foreground="#888"/>
                                <TextBox Text="{Binding MaxHours}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Save" Command="{Binding SaveSettingsCommand}" Background="#007acc" Foreground="White" VerticalAlignment="Bottom"/>
                        </Grid>
                        
                        <!-- Senescence Klaxon Toggle -->
                        <CheckBox Content="Enable Senescence Klaxon ('Daft Bastard' Alert past 144h)"
                                  IsChecked="{Binding EnableSenescenceAlert}"
                                  Foreground="#ccc"
                                  Margin="0,5,0,0"/>

                        <!-- PDF Notes Export Toggle -->
                        <CheckBox Content="Include Session Notes in 90-Day PDF Report"
                                  IsChecked="{Binding IncludeNotesInReport}"
                                  Foreground="#ccc"
                                  Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Clinical Blackout Window" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*, *, Auto, Auto">
                            <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding AppointmentDate}" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                            <TimePicker Grid.Column="1" SelectedTime="{Binding AppointmentTime}" HorizontalAlignment="Stretch" Margin="5,0,10,0"/>
                            <Button Grid.Column="2" Content="Lock" Command="{Binding SetAppointmentCommand}" Background="#007acc" Foreground="White" Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="Clear" Command="{Binding ClearAppointmentCommand}" Background="#555" Foreground="White"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Mathematical Analysis" FontWeight="Bold"/>
                        <UniformGrid Columns="3">
                            <Button Content="Auto-Calibrate" Command="{Binding AutoCalibrateCommand}" Background="#f57c00" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                            <Button Content="Analyze Supps" Command="{Binding AnalyzeSupplementsCommand}" Background="#4caf50" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                            <Button Content="Compare Labs" Command="{Binding OpenDeltaCommand}" Background="#007acc" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                        </UniformGrid>
                        <!-- BIOMETRICS WIZARD BUTTON -->
                        <Button Content="Calibrate Biometric Capacity" Command="{Binding OpenBiometricsCommand}" Background="#1e4a6d" Foreground="White" HorizontalAlignment="Stretch" Margin="2,10,2,2"/>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Database Auto-Backup" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBox Grid.Column="0" Text="{Binding BackupPath}" IsReadOnly="True" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Open Folder" Command="{Binding OpenBackupFolderCommand}" Background="#555" Foreground="White" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="Backup Now" Command="{Binding RunManualBackupCommand}" Background="#007acc" Foreground="White"/>
                        </Grid>
                        <Button Content="Restore Latest Backup" Command="{Binding RestoreLatestBackupCommand}" Background="#d32f2f" Foreground="White" HorizontalAlignment="Stretch"/>
                        <Button Content="Export Data (JSON + CSV)" Command="{Binding ExportDataCommand}" Background="#546e7a" Foreground="White" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="System automatically retains the last 10 backups on exit." FontSize="10" Foreground="#888"/>
                    </StackPanel>

                    <Button Content="{Binding IsTestModeActive, StringFormat='{}Toggle Sandbox Mode (Currently: {0})'}" Command="{Binding ToggleTestModeCommand}" Background="#555" Foreground="White" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- BIOMETRICS & CAPACITY CALIBRATION MODAL -->
        <Border IsVisible="{Binding IsBiometricsOpen}" Background="#B2000000" ZIndex="110">
            <Border Background="#1e1e1e" BorderBrush="#1e4a6d" BorderThickness="1" CornerRadius="8" Width="600" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Biometric Capacity Calibration" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseBiometricsCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Background="#263238" BorderBrush="#546e7a" BorderThickness="1" CornerRadius="6" Padding="15">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SAFE MEASUREMENT PROTOCOL" FontWeight="Bold" Foreground="#90a4ae" FontSize="11"/>
                            <TextBlock Text="A clinical ultrasound is the gold standard for volumetric data. If measuring manually at home, strictly observe the following:" TextWrapping="Wrap" Foreground="#ccc" FontSize="12"/>
                            <TextBlock Text="1. Measure in a warm environment. The cremaster and dartos muscles must be completely relaxed to allow safe isolation." TextWrapping="Wrap" Foreground="#ccc" FontSize="12"/>
                            <TextBlock Text="2. Use digital calipers (zeroed) or a rigid ruler. Gently isolate the testicle against the scrotal skin. DO NOT squeeze or compress the tissue." TextWrapping="Wrap" Foreground="#e53935" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="3. Take three measurements per side: Pole-to-Pole (Length), and side-to-side (Width and Height)." TextWrapping="Wrap" Foreground="#ccc" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="All measurements must be entered in Centimeters (cm)." Foreground="#888" FontStyle="Italic" FontSize="12" HorizontalAlignment="Center"/>

                    <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                        <!-- Left Testicle -->
                        <Border Grid.Column="0" Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,5,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="LEFT TESTICLE" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="Length (cm)" VerticalAlignment="Center" Foreground="#888" Width="75" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding BioLeftL}" Watermark="e.g. 4.1"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="Width (cm)" VerticalAlignment="Center" Foreground="#888" Width="75" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding BioLeftW}" Watermark="e.g. 2.3"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="Height (cm)" VerticalAlignment="Center" Foreground="#888" Width="75" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding BioLeftH}" Watermark="e.g. 2.7"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right Testicle -->
                        <Border Grid.Column="1" Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="15" Margin="5,0,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="RIGHT TESTICLE" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="Length (cm)" VerticalAlignment="Center" Foreground="#888" Width="75" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding BioRightL}" Watermark="e.g. 4.4"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="Width (cm)" VerticalAlignment="Center" Foreground="#888" Width="75" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding BioRightW}" Watermark="e.g. 2.4"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="Height (cm)" VerticalAlignment="Center" Foreground="#888" Width="75" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding BioRightH}" Watermark="e.g. 3.0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#1a1a1a" BorderBrush="#4caf50" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL SPERMATOGENIC CAPACITY" FontSize="11" FontWeight="Bold" Foreground="#888"/>
                                <TextBlock Text="Formula: (L × W × H × 0.71)" FontSize="10" Foreground="#555"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CalculatedTotalVolume, StringFormat='{}{0:F1}'}" FontSize="24" FontWeight="Bold" Foreground="#4caf50"/>
                                <TextBlock Text="mL" FontSize="14" Foreground="#888" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Clear &amp; Reset" Command="{Binding ClearBiometricsCommand}" HorizontalAlignment="Stretch" Background="#d32f2f" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="Save &amp; Scale Telemetry" Command="{Binding SaveBiometricsCommand}" HorizontalAlignment="Stretch" Background="#1e4a6d" Foreground="White" FontWeight="Bold" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MANUAL LOG MODAL -->
        <Border IsVisible="{Binding IsManualLogOpen}" Background="#B2000000" ZIndex="100">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="680" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Add Retroactive Log" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseManualLogCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Date" FontSize="11" Foreground="#888"/>
                            <CalendarDatePicker SelectedDate="{Binding ManualDate}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Time" FontSize="11" Foreground="#888"/>
                            <TimePicker SelectedTime="{Binding ManualTime}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Event Mode" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding ManualMode}" HorizontalAlignment="Stretch">
                                <x:String>Maintenance</x:String>
                                <x:String>Playtime</x:String>
                                <x:String>Baby-Making</x:String>
                                <x:String>Clinical-Lab</x:String>
                                <x:String>Daily Dose</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Volume" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding ManualVolume}" HorizontalAlignment="Stretch">
                                <x:String>Normal</x:String>
                                <x:String>Low</x:String>
                                <x:String>High</x:String>
                                <x:String>None</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <TextBox Grid.Column="0" Text="{Binding ManualReleaseCount}" Watermark="Release count" Margin="2"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding ManualVolumeConfidence}" Margin="2">
                            <x:Static Member="models:VolumeConfidence.Observed"/>
                            <x:Static Member="models:VolumeConfidence.Estimated"/>
                            <x:Static Member="models:VolumeConfidence.Unknown"/>
                        </ComboBox>
                    </Grid>

                    <Border Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid ColumnDefinitions="Auto, *">
                            <ComboBox Grid.Column="0" SelectedIndex="{Binding ManualHeat}" Width="140" Margin="0,0,10,0">
                                <ComboBoxItem>Temp: Normal</ComboBoxItem>
                                <ComboBoxItem>Temp: L1 (Mild)</ComboBoxItem>
                                <ComboBoxItem>Temp: L2 (Fever)</ComboBoxItem>
                                <ComboBoxItem>Temp: L3 (Severe)</ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding ManualZinc}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z" Width="11" Height="11" Foreground="#007acc" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zn" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ManualMaca}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11 2,11C2,11 4,8 9,7C14,6 17,8 17,8Z" Width="11" Height="11" Foreground="#4caf50" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ma" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ManualVitD}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9M12,4.5C13.13,4.5 13.5,4.87 13.5,6V7.5C13.5,8.63 13.13,9 12,9C10.87,9 10.5,8.63 10.5,7.5V6C10.5,4.87 10.87,4.5 12,4.5M12,15C10.87,15 10.5,15.37 10.5,16.5V18C10.5,19.13 10.87,19.5 12,19.5C13.13,19.5 13.5,19.13 13.5,18V16.5C13.5,15.37 13.13,15 12,15M4.5,12C4.5,10.87 4.87,10.5 6,10.5H7.5C8.63,10.5 9,10.87 9,12C9,13.13 8.63,13.5 7.5,13.5H6C4.87,13.5 4.5,13.13 4.5,12M15,12C15,13.13 15.37,13.5 16.5,13.5H18C19.13,13.5 19.5,13.13 19.5,12C19.5,10.87 19.13,10.5 18,10.5H16.5C15.37,10.5 15,10.87 15,12Z" Width="11" Height="11" Foreground="#ffb74d" VerticalAlignment="Center"/>
                                        <TextBlock Text="D3" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ManualVitC}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Width="11" Height="11" Foreground="#f57c00" VerticalAlignment="Center"/>
                                        <TextBlock Text="C" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding ManualTadalafil}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="M11,2H13V19H11V2M9,20H15V22H9V20M12,0L15,3H9L12,0Z" Width="11" Height="11" Foreground="#e53935" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tad" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <ComboBox Classes="dose-selector" SelectedItem="{Binding ManualTadalafilDose}" IsEnabled="{Binding ManualTadalafil}" Margin="0,0,4,0">
                                        <sys:Int32>5</sys:Int32>
                                        <sys:Int32>10</sys:Int32>
                                        <sys:Int32>20</sys:Int32>
                                    </ComboBox>
                                    <TextBlock Text="mg" FontSize="9" Foreground="#888" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="CLINICAL LAB DATA (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding ManualClinicalVol}" Watermark="Vol (mL)" Margin="2"/>
                                <TextBox Text="{Binding ManualConcentration}" Watermark="Conc (M)" Margin="2"/>
                                <TextBox Text="{Binding ManualMotility}" Watermark="Tot Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding ManualProgMotility}" Watermark="Prog Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding ManualMorphology}" Watermark="Morph (%)" Margin="2"/>
                                <TextBox Text="{Binding ManualPhLevel}" Watermark="pH Level" Margin="2"/>
                            </UniformGrid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                <TextBlock Text="{Binding ManualLabFileName, TargetNullValue='No PDF attached...'}" VerticalAlignment="Center" Foreground="#888" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Attach PDF" Command="{Binding SelectManualPdfCommand}" CommandParameter="{Binding #RootWindow}" Background="#546e7a" Foreground="White" FontSize="10" Padding="8,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Notes Field -->
                    <TextBox Text="{Binding ManualNotes}" Watermark="Context, symptoms, external factors..." TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,5,0,0" />

                    <Button Content="Insert Record" Command="{Binding SubmitManualLogCommand}" HorizontalAlignment="Stretch" Background="#007acc" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- EDIT LOG MODAL -->
        <Border IsVisible="{Binding IsEditLogOpen}" Background="#B2000000" ZIndex="100">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="680" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Modify Existing Log" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseEditLogCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Date" FontSize="11" Foreground="#888"/>
                            <CalendarDatePicker SelectedDate="{Binding EditDate}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Time" FontSize="11" Foreground="#888"/>
                            <TimePicker SelectedTime="{Binding EditTime}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Event Mode" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding EditMode}" HorizontalAlignment="Stretch">
                                <x:String>Maintenance</x:String>
                                <x:String>Playtime</x:String>
                                <x:String>Baby-Making</x:String>
                                <x:String>Clinical-Lab</x:String>
                                <x:String>Daily Dose</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Volume" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding EditVolume}" HorizontalAlignment="Stretch">
                                <x:String>Normal</x:String>
                                <x:String>Low</x:String>
                                <x:String>High</x:String>
                                <x:String>None</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <TextBox Grid.Column="0" Text="{Binding EditReleaseCount}" Watermark="Release count" Margin="2"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding EditVolumeConfidence}" Margin="2">
                            <x:Static Member="models:VolumeConfidence.Observed"/>
                            <x:Static Member="models:VolumeConfidence.Estimated"/>
                            <x:Static Member="models:VolumeConfidence.Unknown"/>
                        </ComboBox>
                    </Grid>

                    <Border Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid ColumnDefinitions="Auto, *">
                            <ComboBox Grid.Column="0" SelectedIndex="{Binding EditHeat}" Width="140" Margin="0,0,10,0">
                                <ComboBoxItem>Temp: Normal</ComboBoxItem>
                                <ComboBoxItem>Temp: L1 (Mild)</ComboBoxItem>
                                <ComboBoxItem>Temp: L2 (Fever)</ComboBoxItem>
                                <ComboBoxItem>Temp: L3 (Severe)</ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding EditZinc}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z" Width="11" Height="11" Foreground="#007acc" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zn" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding EditMaca}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11 2,11C2,11 4,8 9,7C14,6 17,8 17,8Z" Width="11" Height="11" Foreground="#4caf50" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ma" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding EditVitD}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9M12,4.5C13.13,4.5 13.5,4.87 13.5,6V7.5C13.5,8.63 13.13,9 12,9C10.87,9 10.5,8.63 10.5,7.5V6C10.5,4.87 10.87,4.5 12,4.5M12,15C10.87,15 10.5,15.37 10.5,16.5V18C10.5,19.13 10.87,19.5 12,19.5C13.13,19.5 13.5,19.13 13.5,18V16.5C13.5,15.37 13.13,15 12,15M4.5,12C4.5,10.87 4.87,10.5 6,10.5H7.5C8.63,10.5 9,10.87 9,12C9,13.13 8.63,13.5 7.5,13.5H6C4.87,13.5 4.5,13.13 4.5,12M15,12C15,13.13 15.37,13.5 16.5,13.5H18C19.13,13.5 19.5,13.13 19.5,12C19.5,10.87 19.13,10.5 18,10.5H16.5C15.37,10.5 15,10.87 15,12Z" Width="11" Height="11" Foreground="#ffb74d" VerticalAlignment="Center"/>
                                        <TextBlock Text="D3" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding EditVitC}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Width="11" Height="11" Foreground="#f57c00" VerticalAlignment="Center"/>
                                        <TextBlock Text="C" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding EditTadalafil}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="M11,2H13V19H11V2M9,20H15V22H9V20M12,0L15,3H9L12,0Z" Width="11" Height="11" Foreground="#e53935" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tad" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <ComboBox Classes="dose-selector" SelectedItem="{Binding EditTadalafilDose}" IsEnabled="{Binding EditTadalafil}" Margin="0,0,4,0">
                                        <sys:Int32>5</sys:Int32>
                                        <sys:Int32>10</sys:Int32>
                                        <sys:Int32>20</sys:Int32>
                                    </ComboBox>
                                    <TextBlock Text="mg" FontSize="9" Foreground="#888" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="CLINICAL LAB DATA (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding EditClinicalVol}" Watermark="Vol (mL)" Margin="2"/>
                                <TextBox Text="{Binding EditConcentration}" Watermark="Conc (M)" Margin="2"/>
                                <TextBox Text="{Binding EditMotility}" Watermark="Tot Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding EditProgMotility}" Watermark="Prog Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding EditMorphology}" Watermark="Morph (%)" Margin="2"/>
                                <TextBox Text="{Binding EditPhLevel}" Watermark="pH Level" Margin="2"/>
                            </UniformGrid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                <TextBlock Text="{Binding EditLabFileName, TargetNullValue='No PDF attached...'}" VerticalAlignment="Center" Foreground="#888" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Update PDF" Command="{Binding SelectEditPdfCommand}" CommandParameter="{Binding #RootWindow}" Background="#546e7a" Foreground="White" FontSize="10" Padding="8,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#151515" BorderBrush="#333" BorderThickness="1" Padding="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Edit history" FontWeight="Bold" Foreground="#9e9e9e"/>
                            <TextBlock Text="{Binding EditHistoryText}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#aaa"/>
                            <ItemsControl ItemsSource="{Binding EditHistoryEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="10" Foreground="#888"/>
                                            <Button Grid.Column="1" Content="Restore" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RestoreEditHistoryCommand}" CommandParameter="{Binding Id}" FontSize="10" Padding="6,2" Background="#546e7a" Foreground="White"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                    <!-- Notes Field -->
                    <TextBox Text="{Binding EditNotes}" Watermark="Context, symptoms, external factors..." TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,5,0,0" />

                    <Button Content="Update Record" Command="{Binding SaveEditLogCommand}" HorizontalAlignment="Stretch" Background="#4caf50" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================================== -->
        <!-- CRITICAL SENESCENCE NOTIFICATION OVERLAY   -->
        <!-- ========================================== -->
        <Grid IsVisible="{Binding ShowWankAlert}" ZIndex="9999" Background="Red">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Style.Animations>
                        <Animation Duration="0:0:0.4" IterationCount="Infinite" PlaybackDirection="Alternate">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0.5"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="0.95"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Grid.Styles>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="50">
                <Grid>
                    <!-- Drop Shadow Text Layer -->
                    <TextBlock Text="GO BEAT YER MEAT,&#x0a;YA DAFT BASTARD!"
                               FontSize="80" 
                               FontWeight="Black"
                               Foreground="Black"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="8,8,0,0"/>

                    <!-- Main White Text Layer -->
                    <TextBlock Text="GO BEAT YER MEAT,&#x0a;YA DAFT BASTARD!"
                               FontSize="80" 
                               FontWeight="Black"
                               Foreground="White"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- The Escape Hatch -->
                <Button Content="ALRIGHT, I'M ON IT! (Dismiss)"
                        Command="{Binding DismissWankAlertCommand}"
                        FontSize="28"
                        FontWeight="Bold"
                        Background="#1e1e1e"
                        Foreground="White"
                        Padding="30,15"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        BorderBrush="White"
                        BorderThickness="2"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
