<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DadPlanner2.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:sys="using:System"
        xmlns:local="using:DadPlanner2"
        xmlns:models="using:DadPlanner2.Models"
        xmlns:converters="using:DadPlanner2.Converters"
        x:Class="DadPlanner2.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="Dad-Planner System Utility" Width="1300" Height="900"
        Background="#121212" Foreground="#e0e0e0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ModeToColorConverter x:Key="ModeColorConverter"/>
        <converters:RelativeTimeConverter x:Key="RelTimeConverter"/>
        <converters:CountdownConverter x:Key="CountConverter"/>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding ToggleStealthCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Button.btn-icon">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="Button.btn-icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#555"/>
        </Style>

        <!-- Global ToolTip Override for the Heatmap -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
    </Window.Styles>

    <!-- The root grid tracks the pointer to feed the custom overlay tooltip -->
    <Grid Background="#121212" PointerMoved="MainContainer_PointerMoved">

        <!-- MAIN APP LAYER -->
        <Grid RowDefinitions="Auto, Auto, *" Margin="20">
            <Grid.Effect>
                <BlurEffect Radius="{Binding StealthBlurRadius}" />
            </Grid.Effect>

            <!-- HEADER -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <TextBlock Text="System Maintenance Utility" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="btn-icon" Content="[?] Help" Command="{Binding OpenHelpCommand}" Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1"/>
                    <Button Classes="btn-icon" Content="[PDF] 90-Day Report" Command="{Binding GeneratePdfCommand}" Background="#546e7a"/>
                    <Button Classes="btn-icon" Content="[+] Add Past Log" Command="{Binding OpenManualLogCommand}"/>
                    <Button Classes="btn-icon" Content="[=] Settings" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>

            <!-- BANNERS -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,15">
                <Border IsVisible="{Binding IsTestModeActive}" Background="#d32f2f" CornerRadius="6" Padding="10,5">
                    <TextBlock Text="WARNING: TEST MODE ACTIVE. FAKE DATA DISPLAYED." FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <Border IsVisible="{Binding IsShadowActive}" Background="#f57c00" CornerRadius="6" Padding="10,5">
                    <TextBlock Text="{Binding ShadowMessage}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <Border IsVisible="{Binding IsBlackoutActive}" Background="{Binding BlackoutColor}" BorderBrush="{Binding BlackoutBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5">
                    <TextBlock Text="{Binding BlackoutMessage}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- MAIN SPLIT -->
            <Grid Grid.Row="2" ColumnDefinitions="1.8*, 1.2*">

                <!-- LEFT PANE -->
                <ScrollViewer Grid.Column="0" Margin="0,0,15,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="15">

                        <!-- HUD GRID -->
                        <UniformGrid Columns="5" Height="70">
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HudCurrent}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                    <TextBlock Text="CURRENT DELTA" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HudRemaining}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                    <TextBlock Text="LIMIT T-MINUS" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HudAvg}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ROLLING AVG" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HudMax}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                    <TextBlock Text="MAX ENDURANCE" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HudFrequency}" FontSize="24" FontWeight="Bold" Foreground="#007acc" HorizontalAlignment="Center"/>
                                    <TextBlock Text="30-DAY FREQ" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- RECOVERY GAP TIMELINE WITH ZOOM -->
                        <Border Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Height="250">
                            <Grid RowDefinitions="Auto, *">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="RECOVERY GAP TIMELINE" FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="10,10,0,5"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5" Margin="0,10,10,5">
                                        <TextBlock Text="ZOOM:" FontSize="10" Foreground="#555" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button Content="30D" Command="{Binding ZoomChartCommand}" CommandParameter="30" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                        <Button Content="90D" Command="{Binding ZoomChartCommand}" CommandParameter="90" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                        <Button Content="ALL" Command="{Binding ZoomChartCommand}" CommandParameter="ALL" FontSize="10" Padding="6,3" Background="#252526" Foreground="#888"/>
                                    </StackPanel>
                                </Grid>

                                <lvc:CartesianChart x:Name="MainChart" Grid.Row="1" Series="{Binding ChartSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Margin="10,0,10,10" ZoomMode="X" DataPointerDownCommand="{Binding ChartClickedCommand}" TooltipPosition="Hidden" />
                            </Grid>
                        </Border>

                        <!-- Analytics Charts -->
                        <Grid ColumnDefinitions="*, *" Height="200">

                            <!-- Doughnut Chart & Custom Legend -->
                            <Border Grid.Column="0" Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <Grid RowDefinitions="Auto, *">
                                    <TextBlock Grid.Row="0" Text="EVENT DISTRIBUTION" FontSize="12" Foreground="#888" Margin="10,10,0,5"/>

                                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="10,0,15,10">
                                        <Grid Grid.Column="0">
                                            <lvc:PieChart x:Name="PieChart" Series="{Binding ModeSeries}" LegendPosition="Hidden" TooltipPosition="Hidden"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TotalEventCount}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Total Logs" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#007acc"/>
                                                <TextBlock Text="{Binding LegendMaint}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#9c27b0"/>
                                                <TextBlock Text="{Binding LegendPlay}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#4caf50"/>
                                                <TextBlock Text="{Binding LegendBaby}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#546e7a"/>
                                                <TextBlock Text="{Binding LegendLab}" FontSize="11" Foreground="#ccc" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Bar Chart (Yield Profile) -->
                            <Border Grid.Column="1" Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto, *">
                                    <TextBlock Grid.Row="0" Text="YIELD PROFILE" FontSize="12" Foreground="#888" Margin="10,10,0,5"/>
                                    <lvc:CartesianChart x:Name="BarChart" Grid.Row="1" Series="{Binding VolumeSeries}" XAxes="{Binding VolumeXAxes}" YAxes="{Binding VolumeYAxes}" Margin="10" TooltipPosition="Hidden"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- GitHub-Style Auto-Scaling Heatmap -->
                        <Border Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="365-DAY ACTIVITY MATRIX" FontSize="12" Foreground="#888" Margin="0,0,0,10"/>

                                <Viewbox Height="110" Stretch="Uniform" HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding HeatmapDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Vertical" Height="110" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorHex}" Width="12" Height="12" Margin="1.5" CornerRadius="2">
                                                    <ToolTip.Tip>
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="{Binding DateText}" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                                                            <TextBlock Text="{Binding MainInfoText}" Foreground="#aaa" FontSize="12"/>
                                                            <Rectangle IsVisible="{Binding HasData}" Height="1" Fill="#333" Margin="0,4"/>
                                                            <TextBlock IsVisible="{Binding HasData}" Text="{Binding ModesText}" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </ToolTip.Tip>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT PANE -->
                <Grid Grid.Column="1" RowDefinitions="Auto, *" Background="#1a1a1a" Margin="5,0,0,0">
                    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="12">
                            <TextBlock Text="LOG NEW EVENT" FontWeight="Bold" Foreground="#888"/>

                            <Grid ColumnDefinitions="*, *">
                                <ComboBox Grid.Column="0" SelectedIndex="{Binding SelectedHeat}" HorizontalAlignment="Stretch" Margin="0,0,5,0">
                                    <ComboBoxItem>Temp: Normal</ComboBoxItem>
                                    <ComboBoxItem>Temp: L1 (Mild)</ComboBoxItem>
                                    <ComboBoxItem>Temp: L2 (Fever)</ComboBoxItem>
                                    <ComboBoxItem>Temp: L3 (Severe)</ComboBoxItem>
                                </ComboBox>
                                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedVolume}" HorizontalAlignment="Stretch" Margin="5,0,0,0">
                                    <x:String>Normal</x:String>
                                    <x:String>Low</x:String>
                                    <x:String>High</x:String>
                                    <x:String>None</x:String>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, *">
                                <TextBox Grid.Column="0" Text="{Binding SelectedReleaseCount}" Watermark="Release count" Margin="2"/>
                                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedVolumeConfidence}" Margin="2">
                                    <x:Static Member="models:VolumeConfidence.Observed"/>
                                    <x:Static Member="models:VolumeConfidence.Estimated"/>
                                    <x:Static Member="models:VolumeConfidence.Unknown"/>
                                </ComboBox>
                            </Grid>

                            <Border Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <TextBlock Text="SUPPS:" FontSize="11" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                                    <CheckBox Content="[Zn]" IsChecked="{Binding ZincActive}"/>
                                    <CheckBox Content="[Ma]" IsChecked="{Binding MacaActive}"/>
                                    <CheckBox Content="[D3]" IsChecked="{Binding VitDActive}"/>
                                    <CheckBox Content="[C]" IsChecked="{Binding VitCActive}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="CLINICAL METRICS (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>
                                    <UniformGrid Columns="3">
                                        <TextBox Text="{Binding ClinicalVol}" Watermark="Vol (mL)" Margin="2"/>
                                        <TextBox Text="{Binding Concentration}" Watermark="Conc (M)" Margin="2"/>
                                        <TextBox Text="{Binding Motility}" Watermark="Tot Mot (%)" Margin="2"/>
                                        <TextBox Text="{Binding ProgMotility}" Watermark="Prog Mot (%)" Margin="2"/>
                                        <TextBox Text="{Binding Morphology}" Watermark="Morph (%)" Margin="2"/>
                                        <TextBox Text="{Binding PhLevel}" Watermark="pH Level" Margin="2"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2" Rows="2">
                                <Button Content="Maintenance" Command="{Binding LogEventCommand}" CommandParameter="Maintenance" Background="#007acc" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                                <Button Content="Playtime" Command="{Binding LogEventCommand}" CommandParameter="Playtime" Background="#9c27b0" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                                <Button Content="Baby-Making" Command="{Binding LogEventCommand}" CommandParameter="Baby-Making" Background="#2e7d32" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                                <Button Content="Clinical Lab" Command="{Binding LogEventCommand}" CommandParameter="Clinical-Lab" Background="#546e7a" Foreground="White" HorizontalAlignment="Stretch" Margin="2"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="LogsGrid" Grid.Row="1" ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" IsReadOnly="True" AutoGenerateColumns="False" Background="#1e1e1e" Margin="0,15,0,0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, Converter={StaticResource RelTimeConverter}}" />
                            <DataGridTemplateColumn Header="Mode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode}" Foreground="{Binding Mode, Converter={StaticResource ModeColorConverter}}" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Metrics" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MetricsDisplay}" VerticalAlignment="Center" FontSize="11" Foreground="#aaa" Margin="5,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MetricsDisplay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button IsVisible="{Binding HasPdf}" Content="PDF" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenPdfCommand}" CommandParameter="{Binding Id}" Background="#546e7a" Foreground="White" FontSize="10" Padding="6,4" Margin="2"/>
                                            <Button Content="EDIT" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenEditLogCommand}" CommandParameter="{Binding Id}" Background="#f57c00" Foreground="White" FontSize="10" Padding="6,4" Margin="2"/>
                                            <Button Content="PURGE" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DeleteLogCommand}" CommandParameter="{Binding Id}" Background="#d32f2f" Foreground="White" FontSize="10" Padding="6,4" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- UI OVERLAY LAYER -->
        <Canvas IsHitTestVisible="False" ZIndex="999">
            <Border IsVisible="{Binding IsTooltipVisible}" Canvas.Left="{Binding TooltipX}" Canvas.Top="{Binding TooltipY}" Background="#1e1e1e" BorderBrush="#555" BorderThickness="1" CornerRadius="6" Padding="15" BoxShadow="0 8 16 0 #B2000000">
                <StackPanel>

                    <StackPanel IsVisible="{Binding HoveredTimelinePoint, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="{Binding HoveredTimelinePoint.HeaderText}" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <TextBlock Text="{Binding HoveredTimelinePoint.GapText}" Foreground="#aaa" FontSize="12"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Mode:" Foreground="#888" FontSize="12"/>
                            <TextBlock Text="{Binding HoveredTimelinePoint.Log.Mode}" Foreground="{Binding HoveredTimelinePoint.ModeHex}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Yield:" Foreground="#888" FontSize="12"/>
                            <TextBlock Text="{Binding HoveredTimelinePoint.Log.Volume}" Foreground="#ccc" FontSize="12"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding HoveredTimelinePoint.HasFlags, FallbackValue=False}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding HoveredTimelinePoint.FlagsText}" Foreground="#ff9800" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                        <Border IsVisible="{Binding HoveredTimelinePoint.HasLab, FallbackValue=False}" Margin="0,4,0,0" Background="#263238" Padding="6" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="CLINICAL DATA:" Foreground="#90a4ae" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding HoveredTimelinePoint.LabText}" Foreground="#fff" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HoveredPie, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="CATEGORY DISTRIBUTION" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <TextBlock Text="{Binding HoveredPie.Category}" Foreground="{Binding HoveredPie.ColorHex}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding HoveredPie.Count, StringFormat='Total Events: {0}'}" Foreground="#aaa" FontSize="12"/>
                        <TextBlock Text="{Binding HoveredPie.Percentage, StringFormat='Share: {0}%'}" Foreground="#888" FontSize="12"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HoveredBar, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
                        <TextBlock Text="YIELD VOLUME" FontWeight="Bold" Foreground="#e0e0e0" FontSize="13"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,4"/>
                        <TextBlock Text="{Binding HoveredBar.Category}" Foreground="{Binding HoveredBar.ColorHex}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding HoveredBar.Count, StringFormat='Total Sessions: {0}'}" Foreground="#aaa" FontSize="12"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Canvas>

        <!-- GENERIC ALERT MODAL -->
        <Border IsVisible="{Binding IsAlertOpen}" Background="#B2000000" ZIndex="200">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="520" MaxHeight="680" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <TextBlock Text="{Binding AlertTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding AlertMessage}" TextWrapping="Wrap" Foreground="#ccc"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAlertCommand}" Background="#333" Foreground="White"/>
                        <Button IsVisible="{Binding ShowAlertConfirm}" Content="Confirm" Command="{Binding ConfirmAlertCommand}" Background="#007acc" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- SUPPLEMENT ANALYSIS VIEW -->
        <Border IsVisible="{Binding IsAnalysisOpen}" Background="#B2000000" ZIndex="210">
            <Border Background="#1e1e1e" BorderBrush="#4caf50" BorderThickness="1" CornerRadius="8"
                    Width="1100" MaxHeight="780" Padding="28" VerticalAlignment="Center"
                    HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Supplement Analysis" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Personal observational comparisons - not clinical evidence"
                                       FontSize="12" Foreground="#9e9e9e"/>
                        </StackPanel>
                        <Button Content="[X]" Command="{Binding CloseAnalysisCommand}" Background="Transparent"
                                Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,0" Background="#151515" BorderBrush="#333" BorderThickness="1"
                            CornerRadius="4" Padding="18">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <UniformGrid Columns="2" Rows="2">
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding ZincAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="8,0,0,8">
                                        <TextBlock Text="{Binding MacaAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="0,8,8,0">
                                        <TextBlock Text="{Binding VitaminDAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                    <Border Background="#202a20" BorderBrush="#4caf50" BorderThickness="1" Padding="12" Margin="8,8,0,0">
                                        <TextBlock Text="{Binding VitaminCAnalysisSummary}" TextWrapping="Wrap" Foreground="#d6d6d6"/>
                                    </Border>
                                </UniformGrid>
                                <Border Background="#151515" Padding="12">
                                    <TextBlock Text="{Binding AnalysisMessage}" TextWrapping="Wrap"
                                               FontFamily="monospace" FontSize="13" Foreground="#d6d6d6"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="10">
                        <TextBlock Text="Full audit details are also available in exported JSON, CSV, and PDF reports."
                                   VerticalAlignment="Center" FontSize="11" Foreground="#888"/>
                        <Button Content="Close" Command="{Binding CloseAnalysisCommand}"
                                Background="#555" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- SETTINGS MODAL (UPDATED WITH BACKUP CONTROLS) -->
        <Border IsVisible="{Binding IsSettingsOpen}" Background="#B2000000" ZIndex="100">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="550" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="20">
                    <Grid>
                        <TextBlock Text="Configuration &amp; Analytics" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseSettingsCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Threshold Limits" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*,*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Min Rest (Hrs)" FontSize="11" Foreground="#888"/>
                                <TextBox Text="{Binding MinHours}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Max Limit (Hrs)" FontSize="11" Foreground="#888"/>
                                <TextBox Text="{Binding MaxHours}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Save" Command="{Binding SaveSettingsCommand}" Background="#007acc" Foreground="White" VerticalAlignment="Bottom"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Clinical Blackout Window" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding AppointmentDate}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Lock" Command="{Binding SetAppointmentCommand}" Background="#007acc" Foreground="White" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearAppointmentCommand}" Background="#555" Foreground="White"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Mathematical Analysis" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*, *">
                            <Button Grid.Column="0" Content="Auto-Calibrate" Command="{Binding AutoCalibrateCommand}" Background="#f57c00" Foreground="White" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="Analyze Supps" Command="{Binding AnalyzeSupplementsCommand}" Background="#4caf50" Foreground="White" HorizontalAlignment="Stretch" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Database Auto-Backup" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBox Grid.Column="0" Text="{Binding BackupPath}" IsReadOnly="True" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Open Folder" Command="{Binding OpenBackupFolderCommand}" Background="#555" Foreground="White" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="Backup Now" Command="{Binding RunManualBackupCommand}" Background="#007acc" Foreground="White"/>
                        </Grid>
                        <Button Content="Restore Latest Backup" Command="{Binding RestoreLatestBackupCommand}" Background="#d32f2f" Foreground="White" HorizontalAlignment="Stretch"/>
                        <Button Content="Export Data (JSON + CSV)" Command="{Binding ExportDataCommand}" Background="#546e7a" Foreground="White" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="System automatically retains the last 10 backups on exit." FontSize="10" Foreground="#888"/>
                    </StackPanel>

                    <Button Content="{Binding IsTestModeActive, StringFormat='{}Toggle Sandbox Mode (Currently: {0})'}" Command="{Binding ToggleTestModeCommand}" Background="#555" Foreground="White" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- HELP MODAL -->
        <Border IsVisible="{Binding IsHelpOpen}" Background="#B2000000" ZIndex="100">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="700" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="PIMS User Manual" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseHelpCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer MaxHeight="600" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="15" Margin="0,0,15,0">

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5">
                                <TextBlock Text="Quick start" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="Use the four event buttons on the right to record a session. The dashboard, timeline, charts, heatmap, and log table update immediately. Use Add Past Log for an event that happened earlier." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="All data is local and offline. The database is stored in your application data directory; no account, cloud sync, or external API is required." TextWrapping="Wrap" Foreground="#ccc"/>

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="Logging a session" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="Before selecting an event type, set the fields that describe the session:" TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="- Temperature: Normal or Levels 1-3. Levels 2 and 3 create a 74-day Thermal Shadow and exclude affected events from uncompromised analysis." TextWrapping="Wrap" Foreground="#ccc" Margin="15,0,0,0"/>
                            <TextBlock Text="- Volume: Normal, Low, High, or None. None means no release was recorded and is excluded from release-based analysis." TextWrapping="Wrap" Foreground="#ccc" Margin="15,0,0,0"/>
                            <TextBlock Text="- Release count: the number of releases remembered for this session. Keep one log for one remembered session; do not invent timestamps for individual releases." TextWrapping="Wrap" Foreground="#ccc" Margin="15,0,0,0"/>
                            <TextBlock Text="- Volume confidence: Observed means visually verified, Estimated means inferred, and Unknown means no reliable volume observation. Confidence is preserved in analysis and exports." TextWrapping="Wrap" Foreground="#ccc" Margin="15,0,0,0"/>
                            <TextBlock Text="Supplements are session modifiers. Clinical fields and an optional PDF attachment belong on Clinical Lab records." TextWrapping="Wrap" Foreground="#ccc"/>

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="Event modes" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="Maintenance is the standard baseline event. Playtime is tracked as a separate activity. Baby-Making records an attempt and automatically estimates volume from available history. Clinical Lab records formal measurements and can provide a ground-truth baseline." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="Recovery gaps are session-based: a multi-release session remains one timeline event. Frequency metrics multiply by Release count where appropriate, but the app never fabricates individual release times." TextWrapping="Wrap" Foreground="#ccc"/>

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="Thermal Shadows and clinical baselines" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="A Level 2 or Level 3 heat event starts a 74-day Thermal Shadow. The warning banner shows when the shadow clears. Recovery and supplement comparisons exclude release events with a prior severe heat event in that window." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="A Clinical Lab record with concentration of at least 15 M/mL and motility of at least 40% can override an active shadow after the heat event. Use the Clinical Blackout Window in Settings to mark an upcoming baseline appointment; the dashboard warns as the date approaches." TextWrapping="Wrap" Foreground="#ccc"/>

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="Charts and analysis" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="The HUD shows current delta, time to the configured limit, rolling average, maximum endurance, and 30-day frequency. Use the timeline zoom buttons for 30 days, 90 days, or all available data. Hover heatmap cells for daily details and click timeline points to locate their log." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="Settings > Analyze Supps opens the desktop Supplement Analysis view. It compares saturated and unsaturated groups using exact 21-day or 30-day windows, a 50% inclusive saturation rule, recovery gaps, yield outcomes, and confidence counts. Treat associations as exploratory observations, not clinical or causal evidence." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="Settings > Auto-Calibrate recommends Floor and Ceiling thresholds from uncompromised recovery gaps. Review the recommendation before accepting it; it does not silently change your settings." TextWrapping="Wrap" Foreground="#ccc"/>

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="Editing and audit history" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="Use EDIT in the log table to correct a date, mode, volume, release count, confidence, supplements, clinical values, or attached PDF. Edited Baby-Making records preserve the volume you explicitly select." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="The edit dialog shows prior changes. Each history entry records the timestamp and tracked transitions, such as volume from Normal to High or confidence from Unknown to Estimated. Deleting a log permanently removes that record." TextWrapping="Wrap" Foreground="#ccc"/>

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="Reports, exports, and recovery" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="The PDF button creates a 90-day report with charts, the raw event log, release counts, confidence, and supplement-analysis appendix, then opens it in the desktop PDF viewer. Settings > Export Data creates JSON and CSV raw exports, structured analysis exports, and edit-history exports; use these for complete per-target and correction audit detail." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="Settings > Backup Now creates a consistent SQLite snapshot. The app also backs up changed data on exit and keeps the newest 10 backups. Restore Latest Backup first creates a pre-restore safety snapshot, validates SQLite integrity, and then reloads the restored data." TextWrapping="Wrap" Foreground="#ccc"/>

                            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,10,0,0">
                                <TextBlock Text="Sandbox and privacy" Foreground="#007acc" FontWeight="Bold" FontSize="16"/>
                            </Border>
                            <TextBlock Text="Toggle Sandbox Mode in Settings to temporarily replace the live dataset with 300 generated records. Sandbox data includes mixed modes, release counts, volume confidence, clinical values, and severe heat events for exercising charts and analysis. Toggle it off to restore your real database; do not treat sandbox results as personal data." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="Press Escape to toggle Stealth Mode. The dashboard blurs sensitive content for screen privacy; press Escape again to restore it." TextWrapping="Wrap" Foreground="#ccc"/>
                            <TextBlock Text="For meaningful comparisons, log consistently, label estimated or unknown observations honestly, and remember that this tool organizes personal observations rather than diagnosing conditions." TextWrapping="Wrap" Foreground="#ccc"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Border>

        <!-- MANUAL LOG MODAL -->
        <Border IsVisible="{Binding IsManualLogOpen}" Background="#B2000000" ZIndex="100">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="550" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Add Retroactive Log" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseManualLogCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Date" FontSize="11" Foreground="#888"/>
                            <CalendarDatePicker SelectedDate="{Binding ManualDate}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Time" FontSize="11" Foreground="#888"/>
                            <TimePicker SelectedTime="{Binding ManualTime}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Event Mode" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding ManualMode}" HorizontalAlignment="Stretch">
                                <x:String>Maintenance</x:String>
                                <x:String>Playtime</x:String>
                                <x:String>Baby-Making</x:String>
                                <x:String>Clinical-Lab</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Volume" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding ManualVolume}" HorizontalAlignment="Stretch">
                                <x:String>Normal</x:String>
                                <x:String>Low</x:String>
                                <x:String>High</x:String>
                                <x:String>None</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <TextBox Grid.Column="0" Text="{Binding ManualReleaseCount}" Watermark="Release count" Margin="2"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding ManualVolumeConfidence}" Margin="2">
                            <x:Static Member="models:VolumeConfidence.Observed"/>
                            <x:Static Member="models:VolumeConfidence.Estimated"/>
                            <x:Static Member="models:VolumeConfidence.Unknown"/>
                        </ComboBox>
                    </Grid>

                    <Border Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid ColumnDefinitions="Auto, *">
                            <ComboBox Grid.Column="0" SelectedIndex="{Binding ManualHeat}" Width="140" Margin="0,0,10,0">
                                <ComboBoxItem>Temp: Normal</ComboBoxItem>
                                <ComboBoxItem>Temp: L1 (Mild)</ComboBoxItem>
                                <ComboBoxItem>Temp: L2 (Fever)</ComboBoxItem>
                                <ComboBoxItem>Temp: L3 (Severe)</ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                <CheckBox Content="[Zn]" IsChecked="{Binding ManualZinc}"/>
                                <CheckBox Content="[Ma]" IsChecked="{Binding ManualMaca}"/>
                                <CheckBox Content="[D3]" IsChecked="{Binding ManualVitD}"/>
                                <CheckBox Content="[C]" IsChecked="{Binding ManualVitC}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="CLINICAL LAB DATA (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding ManualClinicalVol}" Watermark="Vol (mL)" Margin="2"/>
                                <TextBox Text="{Binding ManualConcentration}" Watermark="Conc (M)" Margin="2"/>
                                <TextBox Text="{Binding ManualMotility}" Watermark="Tot Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding ManualProgMotility}" Watermark="Prog Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding ManualMorphology}" Watermark="Morph (%)" Margin="2"/>
                                <TextBox Text="{Binding ManualPhLevel}" Watermark="pH Level" Margin="2"/>
                            </UniformGrid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                <TextBlock Text="{Binding ManualLabFileName, TargetNullValue='No PDF attached...'}" VerticalAlignment="Center" Foreground="#888" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Attach PDF" Command="{Binding SelectManualPdfCommand}" CommandParameter="{Binding #RootWindow}" Background="#546e7a" Foreground="White" FontSize="10" Padding="8,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Insert Record" Command="{Binding SubmitManualLogCommand}" HorizontalAlignment="Stretch" Background="#007acc" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- EDIT LOG MODAL -->
        <Border IsVisible="{Binding IsEditLogOpen}" Background="#B2000000" ZIndex="100">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Width="550" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #A8000000">
                <StackPanel Spacing="15">
                    <Grid>
                        <TextBlock Text="Modify Existing Log" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="[X]" Command="{Binding CloseEditLogCommand}" Background="Transparent" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Date" FontSize="11" Foreground="#888"/>
                            <CalendarDatePicker SelectedDate="{Binding EditDate}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Time" FontSize="11" Foreground="#888"/>
                            <TimePicker SelectedTime="{Binding EditTime}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Event Mode" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding EditMode}" HorizontalAlignment="Stretch">
                                <x:String>Maintenance</x:String>
                                <x:String>Playtime</x:String>
                                <x:String>Baby-Making</x:String>
                                <x:String>Clinical-Lab</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Volume" FontSize="11" Foreground="#888"/>
                            <ComboBox SelectedItem="{Binding EditVolume}" HorizontalAlignment="Stretch">
                                <x:String>Normal</x:String>
                                <x:String>Low</x:String>
                                <x:String>High</x:String>
                                <x:String>None</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <TextBox Grid.Column="0" Text="{Binding EditReleaseCount}" Watermark="Release count" Margin="2"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding EditVolumeConfidence}" Margin="2">
                            <x:Static Member="models:VolumeConfidence.Observed"/>
                            <x:Static Member="models:VolumeConfidence.Estimated"/>
                            <x:Static Member="models:VolumeConfidence.Unknown"/>
                        </ComboBox>
                    </Grid>

                    <Border Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid ColumnDefinitions="Auto, *">
                            <ComboBox Grid.Column="0" SelectedIndex="{Binding EditHeat}" Width="140" Margin="0,0,10,0">
                                <ComboBoxItem>Temp: Normal</ComboBoxItem>
                                <ComboBoxItem>Temp: L1 (Mild)</ComboBoxItem>
                                <ComboBoxItem>Temp: L2 (Fever)</ComboBoxItem>
                                <ComboBoxItem>Temp: L3 (Severe)</ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                <CheckBox Content="[Zn]" IsChecked="{Binding EditZinc}"/>
                                <CheckBox Content="[Ma]" IsChecked="{Binding EditMaca}"/>
                                <CheckBox Content="[D3]" IsChecked="{Binding EditVitD}"/>
                                <CheckBox Content="[C]" IsChecked="{Binding EditVitC}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#1e262b" BorderBrush="#546e7a" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="CLINICAL LAB DATA (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#90a4ae"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding EditClinicalVol}" Watermark="Vol (mL)" Margin="2"/>
                                <TextBox Text="{Binding EditConcentration}" Watermark="Conc (M)" Margin="2"/>
                                <TextBox Text="{Binding EditMotility}" Watermark="Tot Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding EditProgMotility}" Watermark="Prog Mot (%)" Margin="2"/>
                                <TextBox Text="{Binding EditMorphology}" Watermark="Morph (%)" Margin="2"/>
                                <TextBox Text="{Binding EditPhLevel}" Watermark="pH Level" Margin="2"/>
                            </UniformGrid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                <TextBlock Text="{Binding EditLabFileName, TargetNullValue='No PDF attached...'}" VerticalAlignment="Center" Foreground="#888" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Update PDF" Command="{Binding SelectEditPdfCommand}" CommandParameter="{Binding #RootWindow}" Background="#546e7a" Foreground="White" FontSize="10" Padding="8,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#151515" BorderBrush="#333" BorderThickness="1" Padding="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Edit history" FontWeight="Bold" Foreground="#9e9e9e"/>
                            <TextBlock Text="{Binding EditHistoryText}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#aaa"/>
                            <ItemsControl ItemsSource="{Binding EditHistoryEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="10" Foreground="#888"/>
                                            <Button Grid.Column="1" Content="Restore" Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RestoreEditHistoryCommand}" CommandParameter="{Binding Id}" FontSize="10" Padding="6,2" Background="#546e7a" Foreground="White"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Button Content="Update Record" Command="{Binding SaveEditLogCommand}" HorizontalAlignment="Stretch" Background="#4caf50" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
